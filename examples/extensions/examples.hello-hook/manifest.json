{
  "schemaVersion": 2,
  "id": "examples.hello-hook",
  "name": "Hello Hook（样例插件）",
  "version": "0.1.0",
  "minAppVersion": "0.1.0",
  "trust": "sandboxed",
  "activationEvents": ["onTool:hello"],
  "permissions": {},
  "capabilities": {
    "server.tool": {
      "entry": "hooks.py",
      "tools": ["hello"]
    },
    "server.hook": {
      "entry": "hooks.py",
      "events": ["pre_model"],
      "priority": 90
    }
  }
}
